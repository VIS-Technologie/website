# Skopiuj ten plik jako .env.deploy (w tym samym katalogu tools/) i uzupełnij
# danymi z panelu Kylos (panel.kylos.pl -> Twoja usługa -> Dostęp FTP).
# PLIK .env.deploy NIE MOŻE TRAFIĆ DO GITA (jest w .gitignore).

# Host FTP z panelu Kylos (np. ftp.vistechnologie.pl albo serwerNNN.kylos.pl)
FTP_HOST=

# Login FTP (z panelu Kylos)
FTP_USER=

# Hasło FTP
FTP_PASS=

# Katalog domeny na serwerze — sprawdź w panelu; zwykle /public_html
FTP_REMOTE_DIR=/public_html

# ftpes = FTP z szyfrowaniem TLS (explicit) — na Kylos dostępne i zalecane.
# Wpisz ftp tylko, jeśli TLS nie działa.
FTP_PROTOCOL=ftpes
